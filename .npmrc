# RiuPlay: do not run third-party install scripts (supply-chain hardening, as Electron itself did
# in v44). Nothing in this project needs one:
#  - better-sqlite3 >= 13 ships an ABI-stable N-API prebuilt binary; npm 10 would otherwise try an
#    implicit `node-gyp rebuild` because the package contains binding.gyp, which fails on machines
#    without a C++ toolchain;
#  - Electron >= 44 downloads its binary (checksum-verified) on first use, or explicitly with
#    `npm run electron:install`;
#  - esbuild resolves its platform binary from optional dependencies.
# Scripts run explicitly (npm run <name>, npm test) are not affected.
ignore-scripts=true
